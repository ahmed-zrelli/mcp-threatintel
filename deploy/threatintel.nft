#!/usr/sbin/nft -f
# mcp-threatintel firewall table (rendered to /etc/threatintel/threatintel.nft
# by scripts/ubuntu/setup-ubuntu.sh, which replaces @MCP_CLIENTS@).
#
# A dedicated table: the host's own rules (Docker, ufw, ...) are never touched.
# Priority -10 runs these chains before the default filter chains, and a drop
# here is final whatever later chains decide.

table inet threatintel
delete table inet threatintel

table inet threatintel {
	# IPs blocked by approved block_ip / block_feed_c2 actions (filled by the agent).
	set blocklist {
		type ipv4_addr
		flags timeout
		comment "mcp-threatintel: approved blocks"
	}

	# Who may reach the MCP server on port 3707: loopback and the analyst PC only.
	set mcp_clients {
		type ipv4_addr
		elements = { 127.0.0.1, @MCP_CLIENTS@ }
	}

	chain input {
		type filter hook input priority -10; policy accept;
		ip saddr @blocklist counter drop comment "approved block"
		tcp dport 3707 ip saddr != @mcp_clients counter drop comment "MCP server: analyst PC only"
		meta nfproto ipv6 tcp dport 3707 counter drop comment "MCP server: no IPv6"
	}

	chain forward {
		type filter hook forward priority -10; policy accept;
		ip saddr @blocklist counter drop comment "approved block (containers)"
		ip daddr @blocklist counter drop comment "approved block (containers)"
	}

	chain output {
		type filter hook output priority -10; policy accept;
		ip daddr @blocklist counter drop comment "approved block"
	}
}
