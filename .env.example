# ---------------------------------------------------------------------------
# Threat intelligence feeds
# ---------------------------------------------------------------------------
# abuse.ch Auth-Key (required, free: register at https://auth.abuse.ch/, generate key in profile)
ABUSECH_API_KEY=your_abusech_auth_key_here

# AlienVault OTX API key (optional, free: https://otx.alienvault.com/)
# OTX_API_KEY=your_otx_api_key_here

# SQLite intelligence cache. Docker: /data/threatintel.db   Windows (native): ./data/threatintel.db
DB_PATH=./data/threatintel.db

# Lab IOCs reloaded into the cache on every poller cycle
LOCAL_IOCS_FILE=lab/local_iocs.csv

# ---------------------------------------------------------------------------
# MCP server (unprivileged)
# ---------------------------------------------------------------------------
# Bind address. 127.0.0.1 on the PC; 0.0.0.0 only behind a firewall rule (VM / Docker).
MCP_HOST=127.0.0.1
MCP_PORT=3707
MCP_LOG_FORMAT=text

# Browser origins allowed to call /mcp (llama-server WebUI)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional bearer-token auth for the HTTP transport. If set, every client must
# send `Authorization: Bearer <token>`. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# MCP_THREATINTEL_AUTH_TOKEN=your_long_random_token_here

# ---------------------------------------------------------------------------
# Host agent (threatintel-responder, privileged) - shared with the MCP server
# ---------------------------------------------------------------------------
# Windows: tcp://127.0.0.1:3710 / :3711     Linux: unix:///run/threatintel/agent.sock / admin.sock
AGENT_ADDR=tcp://127.0.0.1:3710
ADMIN_ADDR=tcp://127.0.0.1:3711
# Shared secret between the MCP server and the agent channel (scripts/windows/setup.ps1 fills it in)
AGENT_TOKEN=

# --- Console on this PC, agent on the Ubuntu server (split architecture) ---
# Values come from /etc/threatintel/console/ on the server (see docs/RUN-SPLIT.md):
# AGENT_ADDR=tls://192.168.21.129:3712
# PUSH_AGENT_ADDR=tls://192.168.21.129:3712     # the poller sends the intel database there
# ADMIN_ADDR=tls://192.168.21.129:3713
# AGENT_CA=console/agent.crt                     # the agent's certificate (pinned)
# ADMIN_TOKEN_FILE=console/admin.token
# AGENT_TOKEN=<contents of console/agent.token>

# true = log commands only (default). false = really block / quarantine / kill (elevated terminal).
RESPONDER_DRY_RUN=true

# Directories the agent may scan and quarantine from (';' separated on Windows, ':' on Linux)
SCAN_PATHS=C:\Users\YOU\threatintel-lab

# Default block duration. BLOCK_TTL_UNIT=minutes makes expiry quick to test.
BLOCK_DEFAULT_TTL=24
BLOCK_TTL_UNIT=hours

# Extra allowlist entries (auto-discovered: loopback, own IPs, gateway, DNS)
ALLOWLIST_FILE=lab/allowlist.csv

# Failed SSH logins per IP that count as brute force
AUTH_FAIL_THRESHOLD=5

# Defaults (Windows): C:\ProgramData\threatintel\{responder.db,admin.token,quarantine}
# RESPONDER_DATA_DIR=C:\ProgramData\threatintel
